{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "mahan-primary", "name": "رنگ اصلی", "color": "#4f46e5" },
				{ "slug": "mahan-secondary", "name": "رنگ دوم", "color": "#0ea5e9" },
				{ "slug": "mahan-accent", "name": "رنگ تأکید", "color": "#f59e0b" },
				{ "slug": "mahan-success", "name": "سبز", "color": "#16a34a" },
				{ "slug": "mahan-danger", "name": "قرمز", "color": "#e11d48" },
				{ "slug": "mahan-text", "name": "متن", "color": "#1f2937" },
				{ "slug": "mahan-muted", "name": "متن کم‌رنگ", "color": "#6b7280" },
				{ "slug": "mahan-surface", "name": "سطح", "color": "#ffffff" },
				{ "slug": "mahan-background", "name": "پس‌زمینه", "color": "#f6f7fb" },
				{ "slug": "mahan-border", "name": "خط", "color": "#e6e8ef" }
			],
			"gradients": [
				{
					"slug": "mahan-brand",
					"name": "گرادیان برند",
					"gradient": "linear-gradient(135deg, #4f46e5 0%, #0ea5e9 100%)"
				},
				{
					"slug": "mahan-soft",
					"name": "گرادیان ملایم",
					"gradient": "linear-gradient(135deg, rgba(79,70,229,.12) 0%, rgba(14,165,233,.12) 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "وزیرمتن",
					"fontFamily": "'Vazirmatn', 'Segoe UI', Tahoma, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/vazirmatn/Vazirmatn-Regular.woff2" ]
						},
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/vazirmatn/Vazirmatn-Medium.woff2" ]
						},
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/vazirmatn/Vazirmatn-Bold.woff2" ]
						},
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/vazirmatn/Vazirmatn-ExtraBold.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "کوچک", "size": "14px" },
				{ "slug": "medium", "name": "معمولی", "size": "16px" },
				{ "slug": "large", "name": "بزرگ", "size": "22px" },
				{ "slug": "x-large", "name": "خیلی بزرگ", "size": "32px" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--mahan-background)",
			"text": "var(--wp--preset--color--mahan-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "16px",
			"lineHeight": "1.9"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--mahan-primary)" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"h1": { "typography": { "fontWeight": "700", "lineHeight": "1.4" } },
			"h2": { "typography": { "fontWeight": "700", "lineHeight": "1.45" } },
			"h3": { "typography": { "fontWeight": "700", "lineHeight": "1.5" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--mahan-primary)",
					"text": "#ffffff"
				},
				"border": { "radius": "10px" },
				"typography": { "fontWeight": "600" }
			}
		},
		"blocks": {
			"core/quote": {
				"color": { "background": "var(--wp--preset--color--mahan-surface)" },
				"spacing": { "padding": { "top": "20px", "right": "24px", "bottom": "20px", "left": "24px" } },
				"border": { "radius": "12px" }
			},
			"core/code": {
				"color": { "background": "#0f172a", "text": "#e2e8f0" },
				"border": { "radius": "10px" }
			},
			"core/image": {
				"border": { "radius": "18px" }
			}
		}
	}
}
